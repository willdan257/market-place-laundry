APP_NAME="Marketplace Laundry"
APP_ENV=local
APP_DEBUG=true
APP_URL=http://localhost:8000

# Database Configuration
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=marketplace_laundry
DB_USERNAME=root
DB_PASSWORD=

# Google OAuth Credentials (Placeholder)
GOOGLE_AUTH_ENABLED=false
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
GOOGLE_REDIRECT_URI=http://localhost:8000/auth/google/callback

# Google Maps API Key (Placeholder)
GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# Payment Gateway / QRIS Config (Placeholder)
PAYMENT_SERVER_KEY=your_payment_server_key_here
PAYMENT_CLIENT_KEY=your_payment_client_key_here

# AI Customer Assistant
# AI_PROVIDER: gemini (default) atau anthropic
AI_PROVIDER=gemini
AI_API_KEY=your_ai_api_key_here
# Kosongkan AI_MODEL untuk memakai model default provider
AI_MODEL=
# Batas penggunaan per customer
AI_RATE_LIMIT_PER_MINUTE=8
AI_RATE_LIMIT_PER_DAY=100
# Pengunjung tanpa login (per IP)
AI_GUEST_RATE_LIMIT_PER_MINUTE=5
AI_GUEST_RATE_LIMIT_PER_DAY=30
# Opsional (XAMPP Windows): path cacert.pem jika muncul error "SSL certificate problem"
AI_CA_BUNDLE=

# Chatbot Beranda (server Node.js di folder chatbot-server)
CHATBOT_API_URL=http://localhost:3001/api/chat

# SMTP Mailer Configuration
MAIL_HOST=smtp.mailgun.org
MAIL_PORT=587
MAIL_USERNAME=your_smtp_username
MAIL_PASSWORD=your_smtp_password
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=noreply@marketplacelaundry.id
MAIL_FROM_NAME="Marketplace Laundry"

# Security & Encryption Key (AES-256-CBC, minimal 32 karakter)
APP_KEY=base64:4v7NqO2z7T0yV6jX8kL9wP1sQ3rU5tM7bE9aC1dF3gH=
TRUSTED_PROXIES=

# WhatsApp Notification (Fonnte)
WA_ENABLED=false
WA_API_URL=https://api.fonnte.com/send
WA_TOKEN=your_wa_token_here
WA_ADMIN_PHONE=628xxxxxxxxxx

