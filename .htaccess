# Prevent directory indexing
Options -Indexes

# Block sensitive files and directories
<FilesMatch "^\.(env|git|htaccess|DS_Store)">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order deny,allow
        Deny from all
    </IfModule>
</FilesMatch>

# Route requests to public directory
<IfModule mod_rewrite.c>
    RewriteEngine On

    # Prevent direct access to protected application directories
    RewriteRule ^(app|config|database|storage|chatbot-server) - [F,L]

    RewriteRule ^$ public/ [L]
    RewriteRule (.*) public/$1 [L]
</IfModule>
