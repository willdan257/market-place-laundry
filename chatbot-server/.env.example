# Salin file ini menjadi ".env" lalu isi NOUS_API_KEY. Jangan commit file .env.
NOUS_API_KEY=isi_api_key_nous_anda
NOUS_BASE_URL=https://inference-api.nousresearch.com/v1
NOUS_MODEL=Hermes-4-405B

PORT=3001
# Alamat website PHP yang boleh memanggil chatbot (pisahkan dengan koma)
ALLOWED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000,http://localhost

# Batas per IP
RATE_LIMIT_PER_MINUTE=8
RATE_LIMIT_PER_DAY=80
